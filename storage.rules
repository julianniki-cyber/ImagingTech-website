rules_version = '2';
// Paste into Firebase console → Storage → Rules. Use the same EDITOR_EMAIL as firestore.rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{id} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email_verified
        && request.auth.token.email in ['EDITOR_EMAIL']
        && (request.resource == null
            || (request.resource.size < 20 * 1024 * 1024
                && request.resource.contentType.matches('image/.*')));
    }
  }
}
